NTFY_URL=https://ntfy.sh/your-private-topic
NTFY_TITLE=Herdr

# Optional bearer token for protected ntfy topics.
NTFY_TOKEN=

# Number of recent unwrapped pane lines to send as the notification body.
NTFY_LINES=12

# Base URL of your Collie instance (https://github.com/AltanS/collie), no
# trailing slash. When set, notifications include a Click action that opens
# the source pane in Collie, e.g. https://<host>/pane/<workspace_id>%3Ap<N>.
# Leave unset to omit the click action.
COLLIE_URL=
